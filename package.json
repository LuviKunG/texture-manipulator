{
  "name": "texture-manipulator",
  "version": "1.3.1",
  "author": {
    "name": "Thanut Panichyotai (@LuviKunG)",
    "email": "luvikung@gmail.com",
    "url": "https://luvikung.github.io"
  },
  "description": "A simple texture manipulation application built with Next.js and Electron.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "homepage": "https://luvikung.github.io/texture-manipulator",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build && next export",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron": "electron .",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "electron-builder --win",
    "electron:dist": "cross-env ELECTRON=true npm run build && electron-builder",
    "build:electron": "cross-env ELECTRON=true npm run build && tsc -p tsconfig.electron.json",
    "preelectron:pack": "npm run build:electron",
    "preelectron:dist": "npm run build:electron"
  },
  "dependencies": {
    "next": "16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "markdownlint-cli": "^0.46.0",
    "prettier": "3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.luvikung.texture-manipulator",
    "productName": "Texture Manipulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/",
      "out/",
      "node_modules/",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": "dmg"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    }
  }
}
